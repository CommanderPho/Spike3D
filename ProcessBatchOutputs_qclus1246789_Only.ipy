## Build Slurm Scripts:
# Derive venv paths from SPIKE3D_REPO_ROOT when exported (see GreatlakesBatchRunInstructions); else fall back by OS.
_is_windows = (platform.system() == 'Windows')
if _is_windows:
    _default_spike3d_repo_root = r'H:/TEMP/Spike3DEnv_ExploreUpgrade/Spike3DWorkEnv'
    _venv_bin_dir, _python_name = 'Scripts', 'python.exe'
else:
    _default_spike3d_repo_root = '/scratch/kdiba_root/kdiba99/halechr/repos/Spike3D_ExploreEnv'
    _venv_bin_dir, _python_name = 'bin', 'python'
_spike3d_repo_root = Path(os.environ.get('SPIKE3D_REPO_ROOT', _default_spike3d_repo_root)).expanduser().resolve()
_venv_dir = _spike3d_repo_root / 'Spike3D' / '.venv'
_venv_activate_path = str(_venv_dir / _venv_bin_dir / 'activate')
_vscode_python = str(_venv_dir / _venv_bin_dir / _python_name)
assert Path(_venv_activate_path).exists(), f"venv activate missing: {_venv_activate_path}"
assert Path(_vscode_python).exists(), f"venv python missing: {_vscode_python}"
_from_env = 'SPIKE3D_REPO_ROOT' in os.environ
print(f'Using Spike3D repo root: {_spike3d_repo_root} ({"from SPIKE3D_REPO_ROOT env" if _from_env else "fallback default"})')
print(f'venv_activate_path: {_venv_activate_path}')
print(f'vscode_default_interpreter_path: {_vscode_python}')

print(f'batch_execution_target: {batch_execution_target}')

if use_scratch_writes:
    ## GL Turbo->Scratch workaround: copy the load-only local pickle + writable global pickle + tiny sidecars onto scratch and retarget the job write root there.
    good_session_concrete_folders, session_global_data_root_parent_paths, global_data_root_parent_path = GreatlakesTurboToScratchHelpers.stage_sessions_for_scratch_run(turbo_session_folders=good_session_concrete_folders, source_data_root=global_data_root_parent_path, pickle_suffix=override_custom_pickle_suffix, tbin_suffix=decoding_time_bin_filename_suffix, skip_if_dest_newer_or_equal=True)
    _time_checkpoint('paths: GreatlakesTurboToScratchHelpers.stage_sessions_for_scratch_run')

session_basedirs_dict: Dict[IdentifyingContext, Path] = {a_session_folder.context: a_session_folder.path for a_session_folder in good_session_concrete_folders}
effective_included_session_contexts = [c for c in included_session_contexts if c in session_basedirs_dict]
if len(effective_included_session_contexts) != len(included_session_contexts):
    print(f'WARN: generating for {len(effective_included_session_contexts)}/{len(included_session_contexts)} sessions with extant basedirs')

print(f'[GENERATE] writing batch scripts under: {scripts_output_path}')
also_show_figure_script_outputs: bool = False

def _try_copy_to_clipboard(code_str: str, label: str) -> None:
    """Copy if a clipboard exists; on headless SSH/ipython print a marked block of `code_str` for manual copy."""
    try:
        copy_to_clipboard(code_str, message_print=True)
    except (NotImplementedError, OSError) as e:
        _banner: str = '=' * 80
        print(f'WARN: clipboard unavailable ({label}); copy the block below manually. ({type(e).__name__}: {e})')
        print(_banner)
        print(f'BEGIN COPY ({label})')
        print(_banner)
        print(code_str)
        print(_banner)
        print(f'END COPY ({label})')
        print(_banner)

max_parallel_executions = 1
phase_collections: Dict[str, BatchScriptsCollection] = {}
phases_ordered_names: List[str] = []

for active_phase in phases_to_generate:
    print(f"\n{'='*80}\nGENERATING PHASE: {active_phase.name}\n{'='*80}")
    custom_user_completion_functions_dict = phase_any_run_custom_user_completion_functions_dict_dict.get(active_phase, {})
    custom_user_completion_function_template_code, custom_user_completion_functions_dict = MAIN_get_template_string(BATCH_DATE_TO_USE=BATCH_DATE_TO_USE, collected_outputs_path=collected_outputs_path, override_custom_user_completion_functions_dict=custom_user_completion_functions_dict) # never None: None would install the mega set
    print(f'completion_functions: {list(custom_user_completion_functions_dict.keys())}')
    _time_checkpoint(f'MAIN_get_template_string:{active_phase.name}')
    active_phase_dict = active_phase.get_run_configuration(custom_user_completion_function_template_code=custom_user_completion_function_template_code, extra_extended_computations_include_includelist=extra_extended_computations_include_includelist)
    if custom_phase_extended_computations_include_includelist is not None:
        print(f'WARNING: custom_phase_extended_computations_include_includelist: {custom_phase_extended_computations_include_includelist} is provided so only these extended_computation_fns will be used (overwritting the phase defaults!).')
        active_phase_dict['extended_computations_include_includelist'] = custom_phase_extended_computations_include_includelist

    active_phase_dict['override_custom_pickle_suffix'] = override_custom_pickle_suffix
    active_phase_dict['decoding_time_bin_filename_suffix'] = decoding_time_bin_filename_suffix
    if shared_batch_session_completion_handler_kwargs:
        active_phase_dict['batch_session_completion_handler_kwargs'] = {
            **active_phase_dict.get('batch_session_completion_handler_kwargs', {}),
            **shared_batch_session_completion_handler_kwargs,
        }

    active_phase_dict['force_recompute_override_computation_kwargs_dict'] = force_recompute_override_computation_kwargs_dict
    active_phase_dict['override_parameters_flat_keypaths_dict'] = override_parameters_flat_keypaths_dict
    active_phase_dict['custom_user_completion_function_override_kwargs_dict'] = custom_user_completion_function_override_kwargs_dict

    # New-tbin recipe reusing the 25ms local pickle: do not freeze/restrict clean_run (pickle write allowed; phase defaults). continued/final load the shared local pickle, never rewrite it, and write only `-tbin_{N}ms` globals.
    if active_phase.value != ProcessingScriptPhases.clean_run.value:
        # Force-recompute the tbin-dependent globals present in this phase's includelist (the 25ms versions embedded in the local pickle would otherwise validate and be kept). Skipped for the track-body variant, which recomputes everything via its aclu filter.
        if not active_phase_dict.get('batch_session_completion_handler_kwargs', {}).get('apply_track_body_aclu_filter', False):
            _phase_includelist = active_phase_dict['extended_computations_include_includelist']
            active_phase_dict['force_recompute_override_computations_includelist'] = [a_name for a_name in _tbin_dependent_force_recompute_override_computations_includelist if a_name in _phase_includelist]
        active_phase_dict['should_save_local_pipeline_pkl'] = False
        active_phase_dict['skip_save_on_initial_load'] = True

    phase_job_suffix: str = active_phase_dict.pop('phase_job_suffix', None)
    current_job_suffix = base_job_suffix
    if phase_job_suffix is not None:
        current_job_suffix = f"{base_job_suffix}_{phase_job_suffix}"
    active_phase_dict.update(dict(job_suffix=current_job_suffix,
                                   should_use_neptune_logging=False,
                                   create_slurm_scripts=(batch_execution_target == 'slurm'),
                                   create_non_slurm_bash_scripts=(batch_execution_target == 'linux_standalone'),
                                   should_generate_run_scripts=True, should_generate_run_notebooks=True, should_create_vscode_workspace=True,
    ))
    print(f'job_suffix: "{current_job_suffix}"')
    print(f"extended_computations_include_includelist: {active_phase_dict['extended_computations_include_includelist']}")
    print(f"force_recompute_override_computations_includelist: {active_phase_dict.get('force_recompute_override_computations_includelist', [])}")

    batch_scripts_collection: BatchScriptsCollection = generate_batch_single_session_scripts(global_data_root_parent_path, session_batch_basedirs=session_basedirs_dict, included_session_contexts=effective_included_session_contexts, session_global_data_root_parent_paths=session_global_data_root_parent_paths,
                                                                                            output_directory=scripts_output_path, use_separate_run_directories=True,
                                                                                            should_use_file_redirected_output_logging=True,
                                                                                            should_use_viztracer_logging=False,
                                                                                            # venv_activate_path='/scratch/kdiba_root/kdiba99/halechr/repos/Spike3D_ExploreEnv/Spike3D/.venv/bin/activate',  # <-- here
                                                                                            # venv_activate_path='/scratch/kdiba_root/kdiba99/halechr/repos/Spike3D_ExploreEnv/Spike3D/.venv_modern/bin/activate',  # <-- legacy GL override
                                                                                            venv_activate_path=_venv_activate_path,
                                                                                            vscode_default_interpreter_path=_vscode_python,
                                                                                            fail_on_exception=False, # 2025-08-27 - Default
                                                                                            **active_phase_dict
                                                                                        )
    phase_collections[active_phase.name] = batch_scripts_collection
    phases_ordered_names.append(active_phase.name)
    _time_checkpoint(f'generate_batch_single_session_scripts:{active_phase.name}')

    output_python_scripts = batch_scripts_collection.output_python_scripts
    output_jupyter_notebooks = batch_scripts_collection.output_jupyter_notebooks
    output_slurm_scripts = batch_scripts_collection.output_slurm_scripts
    output_non_slurm_bash_scripts = batch_scripts_collection.output_non_slurm_bash_scripts
    vscode_workspace_path = batch_scripts_collection.vscode_workspace_path
    if vscode_workspace_path is not None:
        print(f"vscode_workspace_path:: {vscode_workspace_path}")

    computation_script_paths = [x[0] for x in output_python_scripts]
    generate_figures_script_paths = [x[1] for x in output_python_scripts]
    script_paths = generate_figures_script_paths if active_phase.is_figure_phase else computation_script_paths
    print(f'generate_figures_script_paths: {generate_figures_script_paths}')
    if output_jupyter_notebooks:
        print('Generated jupyter notebooks:')
        for a_notebook_path in output_jupyter_notebooks:
            print(f'  {a_notebook_path}')
        ## END for a_notebook_path in output_jupyter_notebooks...

    if (platform.system() == 'Windows'):
        powershell_script_path = build_windows_powershell_run_script(script_paths, max_concurrent_jobs=max_parallel_executions, script_name=f'run_scripts_{active_phase.name}')
        print(f"powershell_script_path ({active_phase.name}): '{powershell_script_path}'\n")
        if not active_phase.is_figure_phase:
            win_run_start_scripts: str = "\n".join([f"& '{_vscode_python}' '{p}'" for p in script_paths])
            print(f"{active_phase.name} - RunMain (Windows, per session):")
            print(win_run_start_scripts)
            print(f"\nAll sessions this phase:\npowershell -File '{powershell_script_path}'")
            print(f'\n\n')
        if also_show_figure_script_outputs or active_phase_dict.get('should_perform_figure_generation_to_file', False):
            powershell_figures_script_path = build_windows_powershell_run_script(generate_figures_script_paths, max_concurrent_jobs=1, script_name=f'run_figure_scripts_{active_phase.name}')
            print(f"powershell_figures_script_path: '{powershell_figures_script_path}'\n")
            win_figs_start_scripts: str = "\n".join([f"& '{_vscode_python}' '{p}'" for p in generate_figures_script_paths])
            if len(win_figs_start_scripts) > 0:
                print(f"{active_phase.name} - Figures (Windows, per session):")
                print(win_figs_start_scripts)
                print(f'\n\n')

    if (platform.system() != 'Windows'):
        if batch_execution_target == 'linux_standalone':
            bash_run_start_scripts: str = "\n".join([f"bash '{bash_script}'" for bash_script in output_non_slurm_bash_scripts.get('run', [])])
            bash_figs_start_scripts: str = "\n".join([f"bash '{bash_script}'" for bash_script in output_non_slurm_bash_scripts.get('figs', [])])
            if not active_phase.is_figure_phase:
                print(f"{active_phase.name} - RunMain (flat fallback, sequential bash):")
                print(bash_run_start_scripts)
                print(f'\n\n')
            if (active_phase.is_figure_phase or also_show_figure_script_outputs) and (len(bash_figs_start_scripts) > 0):
                print(f"{active_phase.name} - Figures:")
                print(bash_figs_start_scripts)
                print(f'\n\n')
        else:
            sbatch_run_start_slurm_scripts: str = "\n".join([f"sbatch '{slurm_script}'" for slurm_script in output_slurm_scripts.get('run', [])])
            sbatch_figs_start_slurm_scripts: str = "\n".join([f"sbatch '{slurm_script}'" for slurm_script in output_slurm_scripts.get('figs', [])])
            if not active_phase.is_figure_phase:
                print(f"{active_phase.name} - RunMain (flat fallback, no afterok):")
                print(sbatch_run_start_slurm_scripts)
                print(f'\n\n')
            if (active_phase.is_figure_phase or also_show_figure_script_outputs) and (len(sbatch_figs_start_slurm_scripts) > 0):
                print(f"{active_phase.name} - Figures:")
                print(sbatch_figs_start_slurm_scripts)
                print(f'\n\n')
## END for active_phase in phases_to_generate...

print('\n========== DESTINATION SUMMARY ==========')
print(f'scripts_output_path: {scripts_output_path}')
print(f'collected_outputs_path: {collected_outputs_path}')
print(f'global_data_root_parent_path: {global_data_root_parent_path}')
print(f'override_custom_pickle_suffix: {override_custom_pickle_suffix}')
print(f'decoding_time_bin_filename_suffix: {decoding_time_bin_filename_suffix}')

_has_clean_run = any(p.value == ProcessingScriptPhases.clean_run.value for p in phases_to_generate)
if _has_clean_run:
    print('Per-session destinations (clean_run writes loadedSessPickle; later phases write output/global_computation_results{suffix}{tbin}.pkl):')
else:
    print('Per-session destinations (local pickle is load-only; global pickle is written):')
for a_session_folder in good_session_concrete_folders:
    a_basedir = a_session_folder.path
    local_pickle_path = a_basedir.joinpath(f'loadedSessPickle{override_custom_pickle_suffix}.pkl')
    global_pickle_path = a_basedir.joinpath('output', f'global_computation_results{override_custom_pickle_suffix}{decoding_time_bin_filename_suffix}.pkl')
    print(f'  {a_session_folder.context}')
    print(f'    basedir:        {a_basedir}')
    print(f'    load pickle:    {local_pickle_path}')
    print(f'    write global:   {global_pickle_path}')
    print(f'    collected_outputs: {collected_outputs_path}')
## END for a_session_folder in good_session_concrete_folders...

print('========================================\n')

# Per-session phase chains (primary submit path). Slurm: afterok; Lab: sequential bash one session at a time; Windows: sequential python.exe per session.
if (platform.system() != 'Windows') and (len(phase_collections) > 0):
    _phase_chain_backend: str = 'bash' if batch_execution_target == 'linux_standalone' else 'slurm'
    _script_collection_key: str = _phase_chain_backend
    session_phase_scripts = build_session_phase_script_map(phase_collections, script_kind='run', script_collection_key=_script_collection_key)
    chained_submit_path = scripts_output_path / f'submit_phase_chains_{BATCH_DATE_TO_USE}.sh'
    chained_manifest_path = scripts_output_path / f'submit_phase_chains_{BATCH_DATE_TO_USE}.json'
    write_chained_submit_script(session_phase_scripts, out_path=chained_submit_path, phases_ordered=phases_ordered_names, manifest_path=chained_manifest_path, batch_date_to_use=BATCH_DATE_TO_USE, phase_chain_backend=_phase_chain_backend)
    retry_dir = scripts_output_path / f'retry_phase_chains_{BATCH_DATE_TO_USE}'
    for _start_phase in phases_ordered_names[1:]:
        write_all_retry_from_phase_scripts(chained_manifest_path, start_phase=_start_phase, out_dir=retry_dir, phases_ordered=phases_ordered_names)
    ## END for _start_phase in phases_ordered_names[1:]...
    print(f"\nChained submit (primary, {_phase_chain_backend}): bash '{chained_submit_path}'")
    if _phase_chain_backend == 'slurm':
        _cancel_path = chained_submit_path.with_name(chained_submit_path.name.replace('submit_phase_chains_', 'cancel_phase_chains_', 1))
        print(f"Cancel remaining jobs: bash '{_cancel_path}'")
    print(f"Retry scripts dir: '{retry_dir}'")
    print_chain_status_hint(execution_backend=_phase_chain_backend)
    _try_copy_to_clipboard(f"bash '{chained_submit_path}'", label='chained_submit')
    _time_checkpoint('copy_to_clipboard:chained_submit')
elif (platform.system() == 'Windows') and (len(phase_collections) > 0):
    _phase_chain_backend: str = 'powershell'
    session_phase_scripts = build_session_phase_script_map(phase_collections, script_kind='run', script_collection_key='python')
    chained_submit_path = scripts_output_path / f'submit_phase_chains_{BATCH_DATE_TO_USE}.ps1'
    chained_manifest_path = scripts_output_path / f'submit_phase_chains_{BATCH_DATE_TO_USE}.json'
    write_chained_submit_script(session_phase_scripts, out_path=chained_submit_path, phases_ordered=phases_ordered_names, manifest_path=chained_manifest_path, batch_date_to_use=BATCH_DATE_TO_USE, phase_chain_backend=_phase_chain_backend, python_executable=_vscode_python)
    retry_dir = scripts_output_path / f'retry_phase_chains_{BATCH_DATE_TO_USE}'
    for _start_phase in phases_ordered_names[1:]:
        write_all_retry_from_phase_scripts(chained_manifest_path, start_phase=_start_phase, out_dir=retry_dir, phases_ordered=phases_ordered_names)
    ## END for _start_phase in phases_ordered_names[1:]...
    print(f"\nChained submit (primary, powershell): powershell -File '{chained_submit_path}'")
    print('\nPer-session phase chains (run in order; skip remaining phases on failure):')
    for session_key, phase_paths in session_phase_scripts.items():
        print(f"# === {session_key} ===")
        for phase_name in phases_ordered_names:
            if phase_name in phase_paths:
                print(f"& '{_vscode_python}' '{phase_paths[phase_name]}'")
        ## END for phase_name in phases_ordered_names...
        print('')
    ## END for session_key, phase_paths in session_phase_scripts.items()...
    print(f"Retry scripts dir: '{retry_dir}'")
    print_chain_status_hint(execution_backend=_phase_chain_backend)
    _try_copy_to_clipboard(f"powershell -File '{chained_submit_path}'", label='chained_submit')
    _time_checkpoint('copy_to_clipboard:chained_submit')

_print_timing_summary()


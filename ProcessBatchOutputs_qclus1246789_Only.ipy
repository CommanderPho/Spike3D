## Different run configurations:
# ==================================================================================================================== #
# PHASES TO GENERATE (chained per-session submit; default is new-tbin incremental continued_run + final_run)           #
# ==================================================================================================================== #
# New-tbin recipe reusing the existing 25ms local pickle (default `continued_run` + `final_run`):
# - Do not set clean_run (uncomment the 3-phase list only for a full rebuild of the local loadedSessPickle).
# - Load existing qclu/frate loadedSessPickle (override_custom_pickle_suffix, no tbin) — the local pickle is tbin-independent.
# - Do not rewrite that shared local pickle on continued/final (should_save_local_pipeline_pkl=False; save_custom enable_save_pipeline_pkl=False). Freeze is the wrong lever — it would skip the new-tbin global compute.
# - Write global pickle/h5 as -tbin_{N}ms (decoding_time_bin_filename_suffix) so the existing 25ms globals survive.
# - Use the phase-default extended_computations includelists (jonathan / long_short / rank-order / PF-peaks / FAT / heuristics / wcorr all included). tbin-independent results already embedded in the local pickle validate and are skipped; they are re-saved into the -tbin_{N}ms global pickle.
# - MUST force-recompute the tbin-dependent globals (`_tbin_dependent_force_recompute_override_computations_includelist`): the local loadedSessPickle embeds the 25ms global results and the validators only check that result keys exist (not which tbin they were computed at), so without the force list the "-tbin_{N}ms" global pickle would silently contain 25ms decoding.
# - final_run may rewrite collected_outputs CSVs; those names carry _tbin-{N}.

phases_to_generate = [ProcessingScriptPhases.continued_run, ProcessingScriptPhases.final_run]
# phases_to_generate = [ProcessingScriptPhases.clean_run, ProcessingScriptPhases.continued_run, ProcessingScriptPhases.final_run]
# Single-phase fallback (uncomment to generate only one phase, no chain):
# phases_to_generate = [ProcessingScriptPhases.clean_run]
# phases_to_generate = [ProcessingScriptPhases.continued_run]
# phases_to_generate = [ProcessingScriptPhases.figure_run]

# batch_execution_target: str = 'slurm'  # GL default; 'linux_standalone' for Lab bash
_batch_host_tag: str = BATCH_DATE_TO_USE.rsplit('_', 1)[-1]  # e.g. '2026-10-21_GL' -> 'GL'
_batch_execution_target_from_host_tag = {
    'GL': 'slurm',  # Great Lakes
    'Lab': 'linux_standalone',  # Lab workstation, no sbatch
    'Apogee': 'windows',  # Windows workstation, PowerShell
}
if _batch_host_tag in _batch_execution_target_from_host_tag:
    batch_execution_target: str = _batch_execution_target_from_host_tag[_batch_host_tag]
elif platform.system() == 'Windows':
    batch_execution_target = 'windows'  # unknown tag, but this process is on Windows
else:
    raise AssertionError(f"Unknown BATCH_DATE_TO_USE host tag {_batch_host_tag!r} from {BATCH_DATE_TO_USE!r}; expected one of {list(_batch_execution_target_from_host_tag)}")

# END ________________________________________________________________________________________________________________ #
# Per-phase completion templates are built inside `for active_phase in phases_to_generate` from `phase_any_run_custom_user_completion_functions_dict_dict` (replace, never None).

# tbin-dependent globals that must be recomputed at the new tbin even though 25ms versions are already present in the loaded local pickle (validators do not check tbin). Intersected with each phase's includelist inside the phase loop. tbin-independent globals (jonathan, long_short_*, rank_order, PF-peaks, FAT) are deliberately NOT listed and validate from the pickle.
_tbin_dependent_force_recompute_override_computations_includelist = [
    'merged_directional_placefields',
    'directional_decoders_decode_continuous',  # needed after the merged placefields are re-decoded at the new tbin
    'directional_decoders_evaluate_epochs',
    'directional_decoders_epoch_heuristic_scoring',
    'non_PBE_epochs_results',
    'generalized_specific_epochs_decoding',
    'perform_wcorr_shuffle_analysis',
]


{
  "format": "vcactions",
  "version": 1,
  "name": "Default Actions",
  "actions": [
    {
      "name": "Duplicate and Offset 10 pt",
      "steps": [
        {
          "command": "object.move",
          "params": {
            "copy": true,
            "dx": 10,
            "dy": 10
          }
        }
      ]
    },
    {
      "name": "Unite and Simplify",
      "steps": [
        {
          "command": "object.pathfinder.unite",
          "params": {}
        },
        {
          "command": "object.path.simplify",
          "params": {
            "tolerance": 0.5
          }
        }
      ]
    },
    {
      "name": "Center on Artboard",
      "steps": [
        {
          "command": "object.align",
          "params": {
            "horizontal": "center",
            "to": "artboard",
            "vertical": "center"
          }
        }
      ]
    },
    {
      "name": "Outline Text",
      "steps": [
        {
          "command": "type.createOutlines",
          "params": {}
        }
      ]
    },
    {
      "name": "Rotate 90° CW",
      "steps": [
        {
          "command": "object.rotate",
          "params": {
            "angle": -90
          }
        }
      ]
    },
    {
      "name": "Reflect Horizontal",
      "steps": [
        {
          "command": "object.reflect",
          "params": {
            "axis": "vertical"
          }
        }
      ]
    },
    {
      "name": "Smoke move right 5",
      "steps": [
        {
          "command": "select.set",
          "params": {
            "ids": [
              332
            ]
          }
        },
        {
          "command": "object.move",
          "params": {
            "dx": 5.0,
            "dy": 0.0
          }
        }
      ]
    }
  ]
}
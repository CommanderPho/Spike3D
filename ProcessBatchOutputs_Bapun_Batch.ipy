_cli_parser.add_argument('--phases', type=str, default='12', help='Phase digits to generate: 0=clean, 1=continued, 2=final, 3=figure. Default: 12')
_cli_parser.add_argument('--shuffles', type=int, default=1024, help='num_shuffles for shuffle analyses when enabled. Default: 1024')
_cli_parser.add_argument('--only', type=str, default=None, help='Optional targeted-export recipe overlay. Recipes: export_bapun_train_test; pickle_clusterless; pickle_spyglass_clusterless; figures_bapun_train_test; figures_bapun_clusterless; figures_bapun_spyglass_clusterless')
_cli_parser.add_argument('--status', action='store_true', help='Do not generate/submit: find newest matching submit_phase_chains_*.sh and run --status')
_cli_parser.add_argument('--cancel', action='store_true', help='Do not generate/submit: find newest matching submit_phase_chains_*.sh and run --cancel')

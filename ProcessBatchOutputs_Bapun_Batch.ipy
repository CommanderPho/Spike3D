_only_key: Optional[str] = (str(_cli_args.only).strip() if _cli_args.only is not None else None) or None
_only_recipe: Optional[Dict] = None
if _only_key is not None:
    if _only_key not in _ONLY_MODE_RECIPES:
        raise ValueError(f'Unknown --only={_only_key!r}; known recipes: {sorted(set(_ONLY_MODE_RECIPES.keys()))}')
    _only_recipe = _ONLY_MODE_RECIPES[_only_key]
    _cli_phases_before_only = [p.value for p in phases_to_generate]
    phases_to_generate = list(_only_recipe['phases'])
    if _cli_phases_before_only != [p.value for p in phases_to_generate]:
        print(f'WARN: --only={_only_key!r} overrides --phases {_cli_args.phases!r} ({_cli_phases_before_only}) -> {[p.value for p in phases_to_generate]}')
    _recipe_completion_functions_dict: Dict[str, Callable] = dict(_only_recipe['completion_functions']) if ('completion_functions' in _only_recipe) else {_only_recipe['completion_fn_name']: _only_recipe['completion_fn']}
    for _phase in phases_to_generate:
        phase_any_run_custom_user_completion_functions_dict_dict[_phase] = dict(_recipe_completion_functions_dict)
    ## END for _phase in phases_to_generate...
    custom_phase_extended_computations_include_includelist = list(_only_recipe['extended_computations_include_includelist'])
    extra_extended_computations_include_includelist = list(_only_recipe.get('extra_extended_computations_include_includelist', []))
    print(f'cli --only={_only_key!r}: {_only_recipe["description"]}')
    print(f'  completion_functions: {list(_recipe_completion_functions_dict.keys())}')
    print(f'  custom_phase_extended_computations_include_includelist: {custom_phase_extended_computations_include_includelist}')
## END if _only_key is not None...

_batch_host_tag: str = BATCH_DATE_TO_USE.rsplit('_', 1)[-1]  # e.g. '2026-11-27_Bapun_GL' -> 'GL'
_batch_execution_target_from_host_tag = {
    'GL': 'slurm',
    'Lab': 'linux_standalone',
    'Apogee': 'windows',
    'rMBP': 'linux_standalone',
}
if _batch_host_tag in _batch_execution_target_from_host_tag:
    batch_execution_target: str = _batch_execution_target_from_host_tag[_batch_host_tag]
elif platform.system() == 'Windows':
    batch_execution_target = 'windows'
else:
    raise AssertionError(f"Unknown BATCH_DATE_TO_USE host tag {_batch_host_tag!r} from {BATCH_DATE_TO_USE!r}; expected one of {list(_batch_execution_target_from_host_tag)}")

# Bapun typically uses the default loadedSessPickle (no qclu/frate suffix):
override_custom_pickle_suffix = ''
included_qclu_values = [1, 2, 4, 6, 7, 8, 9]
minimum_inclusion_fr_Hz = 1.0
base_job_suffix = f'_bapun_q{"".join(str(q) for q in included_qclu_values)}_fr_{minimum_inclusion_fr_Hz:g}'

num_shuffles: int = int(_cli_args.shuffles)
print(f'cli --shuffles={_cli_args.shuffles!r} -> num_shuffles={num_shuffles}')

drop_previous_result_and_compute_fresh: bool = True

cli_tbin: Optional[float] = parse_decoding_time_bin_size_str(_cli_args.tbin)
cli_laps_tbin: Optional[float] = parse_decoding_time_bin_size_str(_cli_args.laps_tbin)
print(f'cli --tbin={_cli_args.tbin!r} -> cli_tbin={cli_tbin}')
print(f'cli --laps-tbin={_cli_args.laps_tbin!r} -> cli_laps_tbin={cli_laps_tbin}')

ripple_decoding_time_bin_size = cli_tbin if cli_tbin is not None else 0.050
laps_decoding_time_bin_size = cli_laps_tbin if cli_laps_tbin is not None else 0.250
_tbin_ms = int(round(float(ripple_decoding_time_bin_size) * 1000.0))
base_job_suffix = f'{base_job_suffix}_tbin_{_tbin_ms}ms'

decoding_time_bin_filename_suffix: str = build_decoding_time_bin_size_filename_suffix(laps_decoding_time_bin_size=laps_decoding_time_bin_size, ripple_decoding_time_bin_size=ripple_decoding_time_bin_size)

force_recompute_override_computation_kwargs_dict = {
    'merged_directional_placefields': {'laps_decoding_time_bin_size': laps_decoding_time_bin_size, 'ripple_decoding_time_bin_size': ripple_decoding_time_bin_size},
    'directional_decoders_evaluate_epochs': {'should_skip_radon_transform': False},
    'rank_order_shuffle_analysis': {'num_shuffles': num_shuffles, 'skip_laps': False, 'minimum_inclusion_fr_Hz': minimum_inclusion_fr_Hz, 'included_qclu_values': included_qclu_values},
    'epoch_score_shuffle_analysis': dict(num_shuffles=num_shuffles, drop_previous_result_and_compute_fresh=True, enable_heuristic_shuffle_scoring=True, enable_radon_shuffle_scoring=False),
    'non_PBE_epochs_results': dict(epochs_decoding_time_bin_size=ripple_decoding_time_bin_size, frame_divide_bin_size=10.0, training_data_portion=5.0/6.0, compute_1D=True, compute_2D=False, drop_previous_result_and_compute_fresh=drop_previous_result_and_compute_fresh, skip_training_test_split=True),
    'generalized_specific_epochs_decoding': dict(epochs_decoding_time_bin_size=ripple_decoding_time_bin_size, drop_previous_result_and_compute_fresh=drop_previous_result_and_compute_fresh),
}
override_parameters_flat_keypaths_dict = {
    'rank_order_shuffle_analysis.included_qclu_values': included_qclu_values,
    'rank_order_shuffle_analysis.minimum_inclusion_fr_Hz': minimum_inclusion_fr_Hz,
}

custom_user_completion_function_override_kwargs_dict = {
    'backup_previous_session_files_completion_function': dict(desired_suffix=f'{BATCH_DATE_TO_USE}'),
    'generalized_decode_epochs_dict_and_export_results_completion_function': dict(epochs_decoding_time_bin_size=ripple_decoding_time_bin_size, force_recompute=drop_previous_result_and_compute_fresh, debug_print=True),
    'compute_and_export_bapun_train_test_decoder_error_distance_completion_function': dict(training_data_portion=9.0/10.0, laps_decoding_time_bin_size=laps_decoding_time_bin_size, debug_print=False),
    'compute_and_pickle_clusterless_decoder_completion_function': dict(),
    'compute_and_pickle_spyglass_clusterless_decoder_completion_function': dict(pickle_spyglass_clusterless_decoder=True, force_recompute=True, debug_print=False),
    'figures_plot_generalized_decode_epochs_dict_and_export_results_completion_function': dict(),
    'figures_plot_bapun_train_test_decoder_error_distance_completion_function': dict(training_data_portion=9.0/10.0, laps_decoding_time_bin_size=laps_decoding_time_bin_size, debug_print=False),
    'figures_plot_bapun_clusterless_train_test_decoder_error_distance_completion_function': dict(),
    'figures_plot_bapun_spyglass_clusterless_train_test_decoder_error_distance_completion_function': dict(training_data_portion=9.0/10.0, laps_decoding_time_bin_size=laps_decoding_time_bin_size, debug_print=False),
}

phase_custom_user_completion_function_override_kwargs_dict_dict: Dict = {}

if _only_recipe is not None:
    _recipe_completion_fn_override_kwargs: Dict = _only_recipe.get('completion_fn_override_kwargs', None) or {}
    if _recipe_completion_fn_override_kwargs:
        _fn_name_for_kwargs: str = _only_recipe['completion_fn_name']
        custom_user_completion_function_override_kwargs_dict[_fn_name_for_kwargs] = {**custom_user_completion_function_override_kwargs_dict.get(_fn_name_for_kwargs, {}), **_recipe_completion_fn_override_kwargs}
        print(f'--only={_only_key!r} completion_fn_override_kwargs[{_fn_name_for_kwargs}]: {_recipe_completion_fn_override_kwargs}')
    ## END if _recipe_completion_fn_override_kwargs...
## END if _only_recipe is not None...

print(f'base_job_suffix: "{base_job_suffix}"')
print(f'phases_to_generate: {[p.name for p in phases_to_generate]}')

if bool(_cli_args.status) or bool(_cli_args.cancel):
    _chain_mode: str = 'status' if bool(_cli_args.status) else 'cancel'
    _phase_chain_backend: str = 'powershell' if batch_execution_target == 'windows' else ('bash' if batch_execution_target == 'linux_standalone' else 'slurm')
    print(f'cli --{_chain_mode}: looking up chained submit under {scripts_output_path} (host_suffix={_batch_host_suffix!r}, job_suffix={base_job_suffix!r}, batch_date_to_use={BATCH_DATE_TO_USE!r})')
    run_matching_chained_submit_mode(scripts_output_path, host_suffix=_batch_host_suffix, job_suffix=base_job_suffix, mode=_chain_mode, batch_date_to_use=BATCH_DATE_TO_USE, execution_backend=_phase_chain_backend)  # type: ignore[arg-type]
    _print_timing_summary()
    raise SystemExit(0)

# ==================================================================================================================== #
# BEGIN MAIN SCRIPT BODY                                                                                               #
# ==================================================================================================================== #

_, _venv_activate_path, _vscode_python = resolve_spike3d_batch_venv_paths(batch_execution_target)

if use_scratch_writes:
    good_session_concrete_folders, session_global_data_root_parent_paths, global_data_root_parent_path = GreatlakesTurboToScratchHelpers.stage_sessions_for_scratch_run(turbo_session_folders=good_session_concrete_folders, source_data_root=session_discovery_data_root, pickle_suffix=override_custom_pickle_suffix, tbin_suffix=decoding_time_bin_filename_suffix, scratch_data_root=scratch_write_root, skip_if_dest_newer_or_equal=True)
    _time_checkpoint('paths: GreatlakesTurboToScratchHelpers.stage_sessions_for_scratch_run')

session_basedirs_dict: Dict[IdentifyingContext, Path] = {a_session_folder.context: a_session_folder.path for a_session_folder in good_session_concrete_folders}
effective_included_session_contexts = [c for c in included_session_contexts if c in session_basedirs_dict]
if len(effective_included_session_contexts) != len(included_session_contexts):
    print(f'WARN: generating for {len(effective_included_session_contexts)}/{len(included_session_contexts)} sessions with extant basedirs')

# Fallback write root for generate_batch_single_session_scripts when session_global_data_root_parent_paths is used:
if global_data_root_parent_path is None or (not Path(global_data_root_parent_path).exists()):
    global_data_root_parent_path = next(iter(session_global_data_root_parent_paths.values())) if len(session_global_data_root_parent_paths) > 0 else session_discovery_data_root

print(f'[GENERATE] writing batch scripts under: {scripts_output_path}')
also_show_figure_script_outputs: bool = False
max_parallel_executions = 1
phase_collections: Dict[str, BatchScriptsCollection] = {}
phases_ordered_names: List[str] = []

for active_phase in phases_to_generate:
    print(f"\n{'='*80}\nGENERATING PHASE: {active_phase.name}\n{'='*80}")
    custom_user_completion_functions_dict = phase_any_run_custom_user_completion_functions_dict_dict.get(active_phase, {})
    custom_user_completion_function_template_code, custom_user_completion_functions_dict = MAIN_get_template_string(BATCH_DATE_TO_USE=BATCH_DATE_TO_USE, collected_outputs_path=collected_outputs_path, override_custom_user_completion_functions_dict=custom_user_completion_functions_dict)
    print(f'completion_functions: {list(custom_user_completion_functions_dict.keys())}')
    _time_checkpoint(f'MAIN_get_template_string:{active_phase.name}')
    active_phase_dict = active_phase.get_run_configuration(custom_user_completion_function_template_code=custom_user_completion_function_template_code, extra_extended_computations_include_includelist=extra_extended_computations_include_includelist)
    if custom_phase_extended_computations_include_includelist is not None:
        print(f'WARNING: custom_phase_extended_computations_include_includelist: {custom_phase_extended_computations_include_includelist} is provided so only these extended_computation_fns will be used (overwritting the phase defaults!).')
        active_phase_dict['extended_computations_include_includelist'] = custom_phase_extended_computations_include_includelist

    if _only_key is not None:
        _only_recipe_for_phase: Dict = _ONLY_MODE_RECIPES[_only_key]
        if _only_recipe_for_phase.get('should_freeze_pipeline_updates', False):
            active_phase_dict['should_freeze_pipeline_updates'] = True
            print(f'--only={_only_key!r}: forcing should_freeze_pipeline_updates=True')
        active_phase_dict.update({**_ONLY_MODE_SLURM_DEFAULTS, **{k: _only_recipe_for_phase[k] for k in ('slurm_time', 'slurm_mem', 'should_use_largemem') if k in _only_recipe_for_phase}})
    ## END if _only_key is not None...

    # Compute phases must compute/save; figure phase freezes:
    if active_phase.is_figure_phase:
        active_phase_dict['should_freeze_pipeline_updates'] = True
    elif _only_key is None:
        active_phase_dict['should_freeze_pipeline_updates'] = False

    active_phase_dict['override_custom_pickle_suffix'] = override_custom_pickle_suffix
    active_phase_dict['decoding_time_bin_filename_suffix'] = decoding_time_bin_filename_suffix
    active_phase_dict['force_recompute_override_computation_kwargs_dict'] = force_recompute_override_computation_kwargs_dict
    active_phase_dict['override_parameters_flat_keypaths_dict'] = override_parameters_flat_keypaths_dict
    active_phase_dict['force_recompute_override_computations_includelist'] = list(force_recompute_override_computations_includelist)

    _phase_custom_user_completion_function_override_kwargs_dict = deepcopy(custom_user_completion_function_override_kwargs_dict)
    _phase_kwarg_overrides: Dict = phase_custom_user_completion_function_override_kwargs_dict_dict.get(active_phase, {})
    for _a_fn_name, _a_fn_kwargs in _phase_kwarg_overrides.items():
        _phase_custom_user_completion_function_override_kwargs_dict[_a_fn_name] = {**_phase_custom_user_completion_function_override_kwargs_dict.get(_a_fn_name, {}), **_a_fn_kwargs}
    ## END for _a_fn_name, _a_fn_kwargs in _phase_kwarg_overrides.items()...
    active_phase_dict['custom_user_completion_function_override_kwargs_dict'] = _phase_custom_user_completion_function_override_kwargs_dict

    if active_phase.value != ProcessingScriptPhases.clean_run.value:
        if _only_key is not None and ('force_recompute_override_computations_includelist' in _ONLY_MODE_RECIPES[_only_key]):
            active_phase_dict['force_recompute_override_computations_includelist'] = list(_ONLY_MODE_RECIPES[_only_key]['force_recompute_override_computations_includelist'])
        active_phase_dict['should_save_local_pipeline_pkl'] = False
        active_phase_dict['skip_save_on_initial_load'] = True

    phase_job_suffix: str = active_phase_dict.pop('phase_job_suffix', None)
    current_job_suffix = base_job_suffix
    if phase_job_suffix is not None:
        current_job_suffix = f'{base_job_suffix}_{phase_job_suffix}'
    active_phase_dict.update(dict(
        job_suffix=current_job_suffix,
        should_use_wandb_logging=False,
        create_slurm_scripts=(batch_execution_target == 'slurm'),
        create_non_slurm_bash_scripts=(batch_execution_target == 'linux_standalone'),
        should_generate_run_scripts=(not active_phase.is_figure_phase),
        should_generate_figure_scripts=active_phase.is_figure_phase,
        should_generate_run_notebooks=(not active_phase.is_figure_phase),
        should_create_vscode_workspace=True,
        # Bapun run_*.py preflight (skipped automatically for figures_*.py in templating):
        preflight_bapun_batch_helpers_run_all=(not active_phase.is_figure_phase),
    ))
    print(f'job_suffix: "{current_job_suffix}"')
    print(f"extended_computations_include_includelist: {active_phase_dict['extended_computations_include_includelist']}")
    print(f"should_freeze_pipeline_updates: {active_phase_dict.get('should_freeze_pipeline_updates')}")

    batch_scripts_collection: BatchScriptsCollection = generate_batch_single_session_scripts(
        global_data_root_parent_path,
        session_batch_basedirs=session_basedirs_dict,
        included_session_contexts=effective_included_session_contexts,
        session_global_data_root_parent_paths=session_global_data_root_parent_paths,
        output_directory=scripts_output_path,
        use_separate_run_directories=True,
        should_use_file_redirected_output_logging=True,
        should_use_viztracer_logging=False,
        venv_activate_path=_venv_activate_path,
        vscode_default_interpreter_path=_vscode_python,
        fail_on_exception=False,
        **active_phase_dict,
    )
    phase_collections[active_phase.name] = batch_scripts_collection
    phases_ordered_names.append(active_phase.name)
    _time_checkpoint(f'generate_batch_single_session_scripts:{active_phase.name}')

    output_python_scripts = batch_scripts_collection.output_python_scripts
    output_jupyter_notebooks = batch_scripts_collection.output_jupyter_notebooks
    output_slurm_scripts = batch_scripts_collection.output_slurm_scripts
    output_non_slurm_bash_scripts = batch_scripts_collection.output_non_slurm_bash_scripts
    vscode_workspace_path = batch_scripts_collection.vscode_workspace_path
    if vscode_workspace_path is not None:
        print(f'vscode_workspace_path:: {vscode_workspace_path}')

    computation_script_paths = [x[0] for x in output_python_scripts if x[0] is not None]
    generate_figures_script_paths = [x[1] for x in output_python_scripts if (isinstance(x, (list, tuple)) and (x[1] is not None))]
    script_paths = generate_figures_script_paths if active_phase.is_figure_phase else computation_script_paths
    print(f'generate_figures_script_paths: {generate_figures_script_paths}')
    if output_jupyter_notebooks:
        print('Generated jupyter notebooks:')
        for a_notebook_path in output_jupyter_notebooks:
            print(f'  {a_notebook_path}')
        ## END for a_notebook_path in output_jupyter_notebooks...

    if platform.system() == 'Windows':
        powershell_script_path = build_windows_powershell_run_script(script_paths, max_concurrent_jobs=max_parallel_executions, script_name=f'run_scripts_{active_phase.name}')
        print(f"powershell_script_path ({active_phase.name}): '{powershell_script_path}'\n")
        if not active_phase.is_figure_phase:
            win_run_start_scripts: str = "\n".join([f"& '{_vscode_python}' '{p}'" for p in script_paths])
            print(f'{active_phase.name} - RunMain (Windows, per session):')
            print(win_run_start_scripts)
            print(f"\nAll sessions this phase:\npowershell -File '{powershell_script_path}'")
            print(f'\n\n')
        if also_show_figure_script_outputs or active_phase_dict.get('should_perform_figure_generation_to_file', False):
            powershell_figures_script_path = build_windows_powershell_run_script(generate_figures_script_paths, max_concurrent_jobs=1, script_name=f'run_figure_scripts_{active_phase.name}')
            print(f"powershell_figures_script_path: '{powershell_figures_script_path}'\n")
    else:
        if batch_execution_target == 'linux_standalone':
            bash_run_start_scripts: str = "\n".join([f"bash '{bash_script}'" for bash_script in output_non_slurm_bash_scripts.get('run', [])])
            bash_figs_start_scripts: str = "\n".join([f"bash '{bash_script}'" for bash_script in output_non_slurm_bash_scripts.get('figs', [])])
            if not active_phase.is_figure_phase:
                print(f'{active_phase.name} - RunMain (flat fallback, sequential bash):')
                print(bash_run_start_scripts)
                print(f'\n\n')
            if (active_phase.is_figure_phase or also_show_figure_script_outputs) and (len(bash_figs_start_scripts) > 0):
                print(f'{active_phase.name} - Figures:')
                print(bash_figs_start_scripts)
                print(f'\n\n')
        else:
            sbatch_run_start_slurm_scripts: str = "\n".join([f"sbatch '{slurm_script}'" for slurm_script in output_slurm_scripts.get('run', [])])
            sbatch_figs_start_slurm_scripts: str = "\n".join([f"sbatch '{slurm_script}'" for slurm_script in output_slurm_scripts.get('figs', [])])
            if not active_phase.is_figure_phase:
                print(f'{active_phase.name} - RunMain (flat fallback, no afterok):')
                print(sbatch_run_start_slurm_scripts)
                print(f'\n\n')
            if (active_phase.is_figure_phase or also_show_figure_script_outputs) and (len(sbatch_figs_start_slurm_scripts) > 0):
                print(f'{active_phase.name} - Figures:')
                print(sbatch_figs_start_slurm_scripts)
                print(f'\n\n')
## END for active_phase in phases_to_generate...

print('\n========== DESTINATION SUMMARY ==========')
print(f'scripts_output_path: {scripts_output_path}')
print(f'collected_outputs_path: {collected_outputs_path}')
print(f'global_data_root_parent_path: {global_data_root_parent_path}')
print(f'override_custom_pickle_suffix: {override_custom_pickle_suffix!r}')
print(f'decoding_time_bin_filename_suffix: {decoding_time_bin_filename_suffix}')
for a_session_folder in good_session_concrete_folders:
    a_basedir = a_session_folder.path
    local_pickle_path = a_basedir.joinpath(f'loadedSessPickle{override_custom_pickle_suffix}.pkl')
    global_pickle_path = a_basedir.joinpath('output', f'global_computation_results{override_custom_pickle_suffix}{decoding_time_bin_filename_suffix}.pkl')
    print(f'  {a_session_folder.context}')
    print(f'    basedir:        {a_basedir}')
    print(f'    load pickle:    {local_pickle_path}')
    print(f'    write global:   {global_pickle_path}')
    print(f'    data root:      {session_global_data_root_parent_paths.get(a_session_folder.context)}')
## END for a_session_folder in good_session_concrete_folders...
print('========================================\n')

CHAIN_SUBMIT_STAMP: str = f'{get_now_rounded_time_str(rounded_minutes=5, time_separator="-")}{_batch_host_suffix}{base_job_suffix}'
print(f'CHAIN_SUBMIT_STAMP: {CHAIN_SUBMIT_STAMP}')
if (platform.system() != 'Windows') and (len(phase_collections) > 0):
    _phase_chain_backend: str = 'bash' if batch_execution_target == 'linux_standalone' else 'slurm'
    _script_collection_key: str = _phase_chain_backend
    session_phase_scripts = build_session_phase_script_map(phase_collections, script_kind='run', script_collection_key=_script_collection_key)
    chained_submit_path = scripts_output_path / f'submit_phase_chains_{CHAIN_SUBMIT_STAMP}.sh'
    chained_manifest_path = scripts_output_path / f'submit_phase_chains_{CHAIN_SUBMIT_STAMP}.json'
    write_chained_submit_script(session_phase_scripts, out_path=chained_submit_path, phases_ordered=phases_ordered_names, manifest_path=chained_manifest_path, batch_date_to_use=BATCH_DATE_TO_USE, phase_chain_backend=_phase_chain_backend)
    retry_dir = scripts_output_path / f'retry_phase_chains_{CHAIN_SUBMIT_STAMP}'
    for _start_phase in phases_ordered_names[1:]:
        write_all_retry_from_phase_scripts(chained_manifest_path, start_phase=_start_phase, out_dir=retry_dir, phases_ordered=phases_ordered_names)
    ## END for _start_phase in phases_ordered_names[1:]...
    print(f"\nChained submit (primary, {_phase_chain_backend}): bash '{chained_submit_path}'")
    if _phase_chain_backend == 'slurm':
        print(f"Cancel remaining jobs: bash '{chained_submit_path}' --cancel")
        print(f"Chain status: bash '{chained_submit_path}' --status")
    print(f"Retry scripts dir: '{retry_dir}'")
    print_chain_status_hint(execution_backend=_phase_chain_backend)
    _chained_submit_shell_cmd = f"bash '{chained_submit_path}'"
    try_copy_to_clipboard(_chained_submit_shell_cmd, label='chained_submit')
    _time_checkpoint('copy_to_clipboard:chained_submit')
    try_execute_shell_command(_chained_submit_shell_cmd, label='chained_submit')
    _time_checkpoint('try_execute:chained_submit')
elif (platform.system() == 'Windows') and (len(phase_collections) > 0):
    _phase_chain_backend: str = 'powershell'
    session_phase_scripts = build_session_phase_script_map(phase_collections, script_kind='run', script_collection_key='python')
    chained_submit_path = scripts_output_path / f'submit_phase_chains_{CHAIN_SUBMIT_STAMP}.ps1'
    chained_manifest_path = scripts_output_path / f'submit_phase_chains_{CHAIN_SUBMIT_STAMP}.json'
    write_chained_submit_script(session_phase_scripts, out_path=chained_submit_path, phases_ordered=phases_ordered_names, manifest_path=chained_manifest_path, batch_date_to_use=BATCH_DATE_TO_USE, phase_chain_backend=_phase_chain_backend, python_executable=_vscode_python)
    retry_dir = scripts_output_path / f'retry_phase_chains_{CHAIN_SUBMIT_STAMP}'
    for _start_phase in phases_ordered_names[1:]:
        write_all_retry_from_phase_scripts(chained_manifest_path, start_phase=_start_phase, out_dir=retry_dir, phases_ordered=phases_ordered_names)
    ## END for _start_phase in phases_ordered_names[1:]...
    print(f"\nChained submit (primary, powershell): powershell -File '{chained_submit_path}'")
    print(f"Retry scripts dir: '{retry_dir}'")
    print_chain_status_hint(execution_backend=_phase_chain_backend)
    try_copy_to_clipboard(f"powershell -File '{chained_submit_path}'", label='chained_submit')
    _time_checkpoint('copy_to_clipboard:chained_submit')

_print_timing_summary()

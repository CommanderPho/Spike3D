def build_bapun_pickle_suffix(included_qclu_values: List[int], minimum_inclusion_fr_Hz: float) -> str:
    return f"_withNormalComputedReplays-qclu_{included_qclu_values}-frateThresh_{minimum_inclusion_fr_Hz}"


def filter_bapun_session_paths(included_session_contexts: List[IdentifyingContext], good_session_concrete_folders) -> tuple[List[IdentifyingContext], list]:
    """Return filtered (contexts, folders), skipping unregistered or missing on-disk sessions with warnings."""
    session_folder_by_context = {a_session_folder.context: a_session_folder for a_session_folder in good_session_concrete_folders}
    filtered_contexts: List[IdentifyingContext] = []
    filtered_folders = []
    for curr_session_context in included_session_contexts:
        a_session_folder = session_folder_by_context.get(curr_session_context)
        if a_session_folder is None:
            print(f"WARN: skipping {curr_session_context}: not registered in Bapun build_session_basedirs_dict (no known data path)")
            continue
        basedir = Path(a_session_folder.path)
        if not basedir.is_dir():
            print(f"WARN: skipping {a_session_folder.context}: {basedir} (directory missing)")
            continue
        xml_files = list(basedir.glob('*.xml'))
        if len(xml_files) == 0:
            print(f"WARN: skipping {a_session_folder.context}: {basedir} (no .xml file)")
            continue
        if len(xml_files) > 1:
            print(f"WARN: {a_session_folder.context}: multiple .xml files in {basedir}")
        filtered_contexts.append(curr_session_context)
        filtered_folders.append(a_session_folder)
    if len(filtered_contexts) == 0:
        raise FileNotFoundError("Bapun session preflight failed: no valid session paths remain after filtering included_session_contexts.")
    skipped_count = len(included_session_contexts) - len(filtered_contexts)
    if skipped_count > 0:
        print(f"Bapun session preflight: proceeding with {len(filtered_contexts)}/{len(included_session_contexts)} sessions ({skipped_count} skipped due to missing paths).")
    return filtered_contexts, filtered_folders


def resolve_bapun_session_folder_and_root(curr_session_context: IdentifyingContext, known_global_data_root_parent_paths: List[Path], debug_print: bool = False) -> tuple[Optional[Path], Optional[Path]]:
    """Return (global_data_root_parent_path, session_basedir) for the first known root where the session folder exists."""
    for candidate_root in known_global_data_root_parent_paths:
        if not candidate_root.exists():
            if debug_print:
                print(f'  {curr_session_context}: skip root (missing): {candidate_root}')
            continue
        basedirs_dict = BapunDataSessionFormatRegisteredClass.build_session_basedirs_dict(candidate_root, debug_print=False)
        session_basedir = basedirs_dict.get(curr_session_context)
        if session_basedir is None:
            if debug_print:
                print(f'  {curr_session_context}: skip root {candidate_root} (not in build_session_basedirs_dict)')
            continue
        if session_basedir.is_dir():
            if debug_print:
                print(f'{curr_session_context}: using {candidate_root} -> {session_basedir}')
            return candidate_root.resolve(), session_basedir.resolve()
        if debug_print:
            print(f'  {curr_session_context}: skip root {candidate_root} ({session_basedir} not a directory)')
    return None, None


def build_bapun_concrete_session_folders_per_root(included_session_contexts: List[IdentifyingContext], known_global_data_root_parent_paths: List[Path], debug_print: bool = False) -> tuple[List[ConcreteSessionFolder], Dict[IdentifyingContext, Path]]:
    """Resolve each session's data root independently by trying known_global_data_root_parent_paths in priority order (fast -> slow)."""
    good_session_concrete_folders: List[ConcreteSessionFolder] = []
    session_global_data_root_parent_paths: Dict[IdentifyingContext, Path] = {}
    print('Per-session global_data_root_parent_path resolution:')
    for curr_session_context in included_session_contexts:
        resolved_root, session_basedir = resolve_bapun_session_folder_and_root(curr_session_context, known_global_data_root_parent_paths, debug_print=debug_print)
        if resolved_root is None or session_basedir is None:
            if debug_print:
                print(f'  {curr_session_context}: no extant folder on any known root')
            continue
        good_session_concrete_folders.append(ConcreteSessionFolder(curr_session_context, session_basedir))
        session_global_data_root_parent_paths[curr_session_context] = resolved_root
        print(f'  {curr_session_context} -> {resolved_root}')
    return good_session_concrete_folders, session_global_data_root_parent_paths


def submit_slurm_scripts(slurm_script_paths: List[str]) -> List[int]:
    job_ids = []
    for slurm_script in slurm_script_paths:
        result = subprocess.run(f"sbatch '{slurm_script}'", shell=True, check=True, capture_output=True, text=True)
        match = re.search(r'Submitted batch job (\d+)', result.stdout)
        if match is None:
            raise RuntimeError(f"Could not parse sbatch job ID from stdout={result.stdout!r} stderr={result.stderr!r}")
        job_id = int(match.group(1))
        job_ids.append(job_id)
        print(f"Submitted job {job_id}: {slurm_script}")
    return job_ids


def wait_for_slurm_jobs(job_ids: List[int], poll_seconds: int = 60) -> None:
    if len(job_ids) == 0:
        return
    job_id_str = ','.join(str(j) for j in job_ids)
    print(f"Waiting for Slurm jobs: {job_id_str}")
    while True:
        result = subprocess.run(f"squeue -j {job_id_str} -h", shell=True, capture_output=True, text=True)
        if len(result.stdout.strip()) == 0:
            break
        running_count = len([line for line in result.stdout.strip().splitlines() if line.strip()])
        print(f"  still running ({running_count} jobs)...")
        time.sleep(poll_seconds)
    sacct_result = subprocess.run(f"sacct -j {job_id_str} --format=JobID,State,ExitCode,Elapsed -P", shell=True, capture_output=True, text=True)
    print(sacct_result.stdout)
    for line in sacct_result.stdout.splitlines()[1:]:
        if any(bad_state in line for bad_state in ['FAILED', 'CANCELLED', 'TIMEOUT', 'OUT_OF_MEMORY', 'NODE_FAIL']):
            raise RuntimeError(f"Slurm job(s) failed:\n{sacct_result.stdout}")


def write_phase_manifest(phase_name: str, run_slurm_paths: List[str], figs_slurm_paths: List[str], run_job_ids: List[int], figs_job_ids: List[int], manifest_output_dir: Path) -> None:
    manifest_output_dir.mkdir(parents=True, exist_ok=True)
    manifest = {'phase': phase_name, 'run_slurm_paths': run_slurm_paths, 'figs_slurm_paths': figs_slurm_paths, 'run_job_ids': run_job_ids, 'figs_job_ids': figs_job_ids}
    manifest_path = manifest_output_dir / f'manifest_{phase_name}.json'
    with open(manifest_path, 'w') as manifest_file:
        json.dump(manifest, manifest_file, indent=2)
    if len(run_slurm_paths) > 0:
        submit_run_path = manifest_output_dir / f'submit_{phase_name}_run.sh'
        with open(submit_run_path, 'w') as submit_run_file:
            submit_run_file.write('\n'.join([f"sbatch '{p}'" for p in run_slurm_paths]) + '\n')
        print(f"Wrote submit script: {submit_run_path}")
    if len(figs_slurm_paths) > 0:
        submit_figs_path = manifest_output_dir / f'submit_{phase_name}_figs.sh'
        with open(submit_figs_path, 'w') as submit_figs_file:
            submit_figs_file.write('\n'.join([f"sbatch '{p}'" for p in figs_slurm_paths]) + '\n')
        print(f"Wrote submit script: {submit_figs_path}")
    print(f"Wrote phase manifest: {manifest_path}")


def execute_code_block(code_block: str, wait_for_completion: bool = True, poll_seconds: int = 60) -> List[int]:
    """Parse sbatch lines from a code block, submit each script, and optionally wait for completion."""
    slurm_paths = []
    for line in code_block.strip().splitlines():
        line = line.strip()
        if not line.startswith('sbatch '):
            continue
        match = re.search(r"sbatch '([^']+)'", line)
        if match is not None:
            slurm_paths.append(match.group(1))
    job_ids = submit_slurm_scripts(slurm_paths)
    if wait_for_completion:
        wait_for_slurm_jobs(job_ids, poll_seconds=poll_seconds)
    return job_ids


def process_all_phases(
    batch_day_date: str,
    batch_date_to_use: str,
    included_session_contexts: List[IdentifyingContext],
    phase_any_run_custom_user_completion_functions_dict: Dict,
    bapun_figure_custom_user_completion_functions_dict: Dict = None,
    force_recompute_override_computations_includelist: List = None,
    extra_extended_computations_include_includelist: List = None,
    custom_phase_extended_computations_include_includelist: List = None,
    included_qclu_values: List = None,
    minimum_inclusion_fr_Hz: float = 1.0,
    num_shuffles: int = 1024,
    drop_previous_result_and_compute_fresh: bool = True,
    laps_decoding_time_bin_size: float = 0.250,
    ripple_decoding_time_bin_size: float = 0.050,
    enable_auto_code_block_execution: bool = False,
    max_parallel_executions: int = 1,
    also_show_figure_script_outputs: bool = False,
    wait_between_phases: bool = True,
    copy_commands_to_clipboard: bool = False,
    slurm_poll_seconds: int = 60,
    phases_to_run: List[ProcessingScriptPhases] = None
):
    """
    Process all phases of the batch computation pipeline automatically.

    Args:
        batch_day_date: Date string for the batch
        batch_date_to_use: Full batch identifier string
        included_session_contexts: List of session contexts to process
        phase_any_run_custom_user_completion_functions_dict: Custom completion functions
        bapun_figure_custom_user_completion_functions_dict: Figure-phase-only completion functions merged on figure_run
        force_recompute_override_computations_includelist: List of computations to force recompute
        extra_extended_computations_include_includelist: Additional extended computations
        custom_phase_extended_computations_include_includelist: Custom phase computations
        included_qclu_values: Quality cluster values to include
        minimum_inclusion_fr_Hz: Minimum firing rate threshold
        num_shuffles: Number of shuffles for analysis
        drop_previous_result_and_compute_fresh: Whether to recompute from scratch
        laps_decoding_time_bin_size: Time bin size for laps decoding
        ripple_decoding_time_bin_size: Time bin size for ripple decoding
        enable_auto_code_block_execution: Whether to auto-submit generated Slurm scripts and wait for completion
        max_parallel_executions: Maximum parallel script executions (Windows PowerShell only)
        also_show_figure_script_outputs: Whether to print figure sbatch commands during compute phases
        wait_between_phases: Whether to wait for user input between phases (manual mode only)
        copy_commands_to_clipboard: Whether to copy sbatch commands to clipboard (manual fallback)
        slurm_poll_seconds: Poll interval when waiting for Slurm jobs
        phases_to_run: Specific phases to run (if None, runs all phases)
    """
    if not enable_auto_code_block_execution and wait_between_phases is False:
        wait_between_phases = True
        print("Manual mode: enabling wait_between_phases because enable_auto_code_block_execution=False")

    # Set default values
    if force_recompute_override_computations_includelist is None:
        force_recompute_override_computations_includelist = []
    if extra_extended_computations_include_includelist is None:
        extra_extended_computations_include_includelist = []
    if included_qclu_values is None:
        included_qclu_values = [1, 2]
    if phases_to_run is None:
        # Default: skip clean_run (full reload); start from continued_run unless you need a fresh pipeline rebuild.
        phases_to_run = [
            ProcessingScriptPhases.continued_run,
            ProcessingScriptPhases.final_run,
            ProcessingScriptPhases.figure_run
        ]
    if bapun_figure_custom_user_completion_functions_dict is None:
        bapun_figure_custom_user_completion_functions_dict = {}

    # Setup paths
    known_scripts_output_paths = [Path(v).resolve() for v in [
        '/nfs/turbo/umms-kdiba/Pho/Output/gen_scripts',
        '/home/halechr/cloud/turbo/Data/Output/gen_scripts/',
        Path(r"W:/Data/Output/gen_scripts"),
    ]]
    scripts_output_path = find_first_extant_path(known_scripts_output_paths)
    assert scripts_output_path.exists(), f"scripts_output_path: {scripts_output_path} does not exist!"
    batch_manifest_dir = scripts_output_path / f'bapun_batch_{batch_date_to_use}'
    batch_manifest_dir.mkdir(parents=True, exist_ok=True)

    collected_outputs_path = scripts_output_path.joinpath('../collected_outputs').resolve()
    collected_outputs_path.mkdir(exist_ok=True)

    print(f'scripts_output_path: {scripts_output_path}')
    print(f'batch_manifest_dir: {batch_manifest_dir}')
    print(f'collected_outputs_path: {collected_outputs_path}')
    print(f'sys.executable: {sys.executable}')

    # Per-session data roots: list order = storage priority (fast -> slow). Comment/uncomment blocks per machine.
    known_global_data_root_parent_paths = [
        Path(r'W:/Data'), 
        Path('/scratch/kdiba_root/kdiba99/halechr/Data'),
        # Path('/Users/pho/data'),
        Path(r'/nfs/turbo/umms-kdiba/Data'),
        # Path(r'/media/halechr/MAX/Data'),
        # Path(r'/home/halechr/FastData'),
        # Path(r'/Volumes/MoverNew/data')
    ]
    global_data_root_parent_path = find_first_extant_path(known_global_data_root_parent_paths)
    assert global_data_root_parent_path.exists(), f"global_data_root_parent_path: {global_data_root_parent_path} does not exist!"
    print(f'global_data_root_parent_path (fallback default): {global_data_root_parent_path}')

    known_vscode_default_interpreter_paths = [Path(v).expanduser() for v in [
        '/scratch/kdiba_root/kdiba99/halechr/repos/Spike3D_ExploreEnv/Spike3D/.venv/bin/python',
        r'H:/TEMP/Spike3DEnv_ExploreUpgrade/Spike3DWorkEnv/Spike3D/.venv/Scripts/python.exe', 
        r'C:/Users/pho/repos/Spike3DWorkEnv/Spike3D/.venv_UV/Scripts/python',
        '~/repos/Spike3D/.venv/bin/python',
        # '/home/halechr/repos/Spike3D/.venv/bin/python',

    ]] + [Path(sys.executable).resolve()]
    vscode_default_interpreter_path = find_first_extant_path(known_vscode_default_interpreter_paths)
    assert vscode_default_interpreter_path.exists(), f"vscode_default_interpreter_path: {vscode_default_interpreter_path} does not exist!"
    print(f'vscode_default_interpreter_path: {vscode_default_interpreter_path}')

    good_session_concrete_folders, session_global_data_root_parent_paths = build_bapun_concrete_session_folders_per_root(included_session_contexts=included_session_contexts, known_global_data_root_parent_paths=known_global_data_root_parent_paths, debug_print=True)
    included_session_contexts, good_session_concrete_folders = filter_bapun_session_paths(included_session_contexts, good_session_concrete_folders)
    session_global_data_root_parent_paths = {a_session_folder.context: session_global_data_root_parent_paths[a_session_folder.context] for a_session_folder in good_session_concrete_folders}

    # bapun_pickle_suffix = build_bapun_pickle_suffix(included_qclu_values=included_qclu_values, minimum_inclusion_fr_Hz=minimum_inclusion_fr_Hz)
    bapun_pickle_suffix = '' # No pickle suffix, use default name

    job_suffix = f"_bapun{bapun_pickle_suffix}_tbin_25ms"
    print(f'bapun_pickle_suffix: "{bapun_pickle_suffix}"')
    print(f'base job_suffix: "{job_suffix}"')

    # Process each phase
    for phase_idx, active_phase in enumerate(phases_to_run):
        print(f"\n{'='*80}")
        print(f"PROCESSING PHASE {phase_idx + 1}/{len(phases_to_run)}: {active_phase.name}")
        print(f"{'='*80}")

        # Get custom completion functions
        active_override_dict = dict(phase_any_run_custom_user_completion_functions_dict)
        if active_phase.is_figure_phase:
            active_override_dict = active_override_dict | bapun_figure_custom_user_completion_functions_dict
        custom_user_completion_function_template_code, custom_user_completion_functions_dict = MAIN_get_template_string(
            BATCH_DATE_TO_USE=batch_date_to_use,
            collected_outputs_path=collected_outputs_path,
            override_custom_user_completion_functions_dict=active_override_dict
        )

        # Get phase configuration
        active_phase_dict = active_phase.get_run_configuration(
            custom_user_completion_function_template_code=custom_user_completion_function_template_code,
            extra_extended_computations_include_includelist=extra_extended_computations_include_includelist
        )

        # Apply custom computations if provided
        if custom_phase_extended_computations_include_includelist is not None:
            print(f'WARNING: Using custom extended computations: {custom_phase_extended_computations_include_includelist}')
            active_phase_dict['extended_computations_include_includelist'] = custom_phase_extended_computations_include_includelist

        # Setup phase-specific parameters
        active_phase_dict.update({
            'vscode_default_interpreter_path': str(vscode_default_interpreter_path.as_posix()),
            'should_freeze_pipeline_updates': False,
            'override_custom_pickle_suffix': bapun_pickle_suffix,
            'force_recompute_override_computation_kwargs_dict': {
                'merged_directional_placefields': {
                    'laps_decoding_time_bin_size': laps_decoding_time_bin_size,
                    'ripple_decoding_time_bin_size': ripple_decoding_time_bin_size
                },
                'directional_decoders_evaluate_epochs': {'should_skip_radon_transform': False},
                'rank_order_shuffle_analysis': {
                    'num_shuffles': num_shuffles,
                    'skip_laps': False,
                    'minimum_inclusion_fr_Hz': minimum_inclusion_fr_Hz,
                    'included_qclu_values': included_qclu_values
                },
                'perform_wcorr_shuffle_analysis': dict(
                    num_shuffles=num_shuffles,
                    drop_previous_result_and_compute_fresh=True
                ),
                'non_PBE_epochs_results': dict(
                    epochs_decoding_time_bin_size=ripple_decoding_time_bin_size,
                    frame_divide_bin_size=10.0,
                    training_data_portion=5.0/6.0,
                                        compute_1D=True,
                    compute_2D=False,
                    drop_previous_result_and_compute_fresh=drop_previous_result_and_compute_fresh,
                    skip_training_test_split=True
                ),
                'generalized_specific_epochs_decoding': dict(
                    epochs_decoding_time_bin_size=ripple_decoding_time_bin_size,
                    drop_previous_result_and_compute_fresh=drop_previous_result_and_compute_fresh
                ),
            },
            'force_recompute_override_computations_includelist': force_recompute_override_computations_includelist,
            'override_parameters_flat_keypaths_dict': {
                'rank_order_shuffle_analysis.included_qclu_values': included_qclu_values,
                'rank_order_shuffle_analysis.minimum_inclusion_fr_Hz': minimum_inclusion_fr_Hz,
            },
            'custom_user_completion_function_override_kwargs_dict': {
                'compute_and_export_session_alternative_replay_wcorr_shuffles_completion_function': dict(
                    included_qclu_values=included_qclu_values,
                    minimum_inclusion_fr_Hz=minimum_inclusion_fr_Hz,
                    ripple_decoding_time_bin_size=ripple_decoding_time_bin_size,
                    num_wcorr_shuffles=num_shuffles,
                    drop_previous_result_and_compute_fresh=drop_previous_result_and_compute_fresh
                ),
                'compute_and_export_session_extended_placefield_peak_information_completion_function': dict(
                    save_csv=True,
                    save_json=False
                ),
                'compute_and_export_decoders_epochs_decoding_and_evaluation_dfs_completion_function': dict(
                    ripple_decoding_time_bin_size_override=ripple_decoding_time_bin_size,
                    laps_decoding_time_bin_size_override=laps_decoding_time_bin_size,
                    needs_recompute_heuristics=True,
                    force_recompute_all_decoding=True,
                    save_hdf=False,
                    allow_append_to_session_h5_file=False,
                    max_ignore_bins=2,
                    same_thresh_cm=10.7,
                    max_jump_distance_cm=60.0,
                ),
                'generalized_decode_epochs_dict_and_export_results_completion_function': dict(
                    epochs_decoding_time_bin_size=ripple_decoding_time_bin_size,
                    force_recompute=drop_previous_result_and_compute_fresh,
                    debug_print=True
                ),
                'compute_and_export_bapun_train_test_decoder_error_distance_completion_function': dict(
                    training_data_portion=9.0/10.0,
                    laps_decoding_time_bin_size=laps_decoding_time_bin_size,
                    debug_print=False
                ),
                'export_decoded_context_uncertainty_by_position_completion_function': dict(time_bin_size=laps_decoding_time_bin_size, show_pos_by_ctxt_joint_figure=True),
                'figures_plot_generalized_decode_epochs_dict_and_export_results_completion_function': dict(),
                'compute_and_pickle_clusterless_decoder_completion_function': dict(), 
                'figures_plot_bapun_clusterless_train_test_decoder_error_distance_completion_function': dict(),
            }
        })

        # Add phase-specific job suffix
        phase_job_suffix = active_phase_dict.pop('phase_job_suffix', None)
        current_job_suffix = job_suffix
        if phase_job_suffix is not None:
            current_job_suffix = f"{job_suffix}_{phase_job_suffix}"

        active_phase_dict.update({
            'job_suffix': current_job_suffix,
            # 'should_freeze_pipeline_updates': False, # False => the pipeline is allowed to update/recompute AND the generated run script saves the pipeline (and global results) when done (continued/final runs render saving_mode=TEMP_THEN_OVERWRITE)
            'should_freeze_pipeline_updates': True,
            'skip_save_on_initial_load': True, # False => save the session pickle immediately after the initial pipeline load/rebuild (before extended computations), so a session pickle exists even if later computations fail
            'should_use_neptune_logging': False,
            'create_slurm_scripts': True,
            'should_generate_run_scripts': True,
            'should_generate_run_notebooks': True,
            # 'should_generate_run_notebooks': False,
            'should_create_vscode_workspace': True,
            # 'preflight_bapun_batch_helpers_run_all': False, # Bapun-specific
            'preflight_bapun_batch_helpers_run_all': True, # Bapun-specific
        })

        print(f'Phase: {active_phase.name}')
        print(f'Job suffix: "{current_job_suffix}"')
        print(f'Extended computations: {active_phase_dict["extended_computations_include_includelist"]}')

        # Generate scripts for this phase
        session_basedirs_dict = {a_session_folder.context: a_session_folder.path for a_session_folder in good_session_concrete_folders}

        # For format_name='bapun', each generated `run_*.py` (and matching temp notebook) passes preflight_bapun_batch_helpers_run_all so `run_specific_batch` runs `BapunBatchHelpers.run_all(curr_active_pipeline)` after `batch_load_session` and before batch completion helpers; `figures_*.py` skips that preflight (see pyphoplacecellanalysis General.Batch.runBatch / pythonScriptTemplating).

        batch_scripts_collection = generate_batch_single_session_scripts(
            global_data_root_parent_path,
            session_batch_basedirs=session_basedirs_dict,
            included_session_contexts=included_session_contexts,
            session_global_data_root_parent_paths=session_global_data_root_parent_paths,
            output_directory=scripts_output_path,
            use_separate_run_directories=True,
            should_use_file_redirected_output_logging=True,
            batch_script_subdirectory=active_phase.name,
            **active_phase_dict
        )

        output_python_scripts = batch_scripts_collection.output_python_scripts
        output_jupyter_notebooks = batch_scripts_collection.output_jupyter_notebooks
        output_slurm_scripts = batch_scripts_collection.output_slurm_scripts
        vscode_workspace_path = batch_scripts_collection.vscode_workspace_path
        batch_scripts_root_directory = batch_scripts_collection.batch_scripts_root_directory

        # if vscode_workspace_path is not None:
        #     print(f"VSCode workspace: {vscode_workspace_path}")

        computation_script_paths = [x[0] for x in output_python_scripts]
        generate_figures_script_paths = [x[1] for x in output_python_scripts]
        run_slurm_paths = list(output_slurm_scripts.get('run', []))
        figs_slurm_paths = list(output_slurm_scripts.get('figs', []))
        run_job_ids: List[int] = []
        figs_job_ids: List[int] = []

        if platform.system() == 'Windows':
            script_paths = generate_figures_script_paths if active_phase.is_figure_phase else computation_script_paths
            powershell_script_path = build_windows_powershell_run_script(script_paths, max_concurrent_jobs=max_parallel_executions, script_name=f'run_scripts_{active_phase.name}', batch_scripts_root_directory=batch_scripts_root_directory)
            print(f"PowerShell script: '{powershell_script_path}'")
            if also_show_figure_script_outputs or active_phase_dict['should_perform_figure_generation_to_file']:
                powershell_figures_script_path = build_windows_powershell_run_script(generate_figures_script_paths, max_concurrent_jobs=1, script_name=f'run_figure_scripts_{active_phase.name}', batch_scripts_root_directory=batch_scripts_root_directory)
                print(f"PowerShell figures script: '{powershell_figures_script_path}'")

        else:
            phase_manifest_dir = batch_manifest_dir / active_phase.name
            if len(run_slurm_paths) > 0:
                sbatch_run_start_slurm_scripts = "\n".join([f"sbatch '{slurm_script}'" for slurm_script in run_slurm_paths])
                print(f"\n{active_phase.name} - RunMain:")
                print(sbatch_run_start_slurm_scripts)
                if copy_commands_to_clipboard and not enable_auto_code_block_execution:
                    copy_to_clipboard(sbatch_run_start_slurm_scripts, message_print=True)
                if enable_auto_code_block_execution:
                    print(f'Submitting {active_phase.name} run scripts...')
                    run_job_ids = submit_slurm_scripts(run_slurm_paths)
                    wait_for_slurm_jobs(run_job_ids, poll_seconds=slurm_poll_seconds)

            if active_phase.is_figure_phase or also_show_figure_script_outputs:
                if len(figs_slurm_paths) > 0:
                    sbatch_figs_start_slurm_scripts = "\n".join([f"sbatch '{slurm_script}'" for slurm_script in figs_slurm_paths])
                    print(f"\n{active_phase.name} - Figures:")
                    print(sbatch_figs_start_slurm_scripts)
                    if copy_commands_to_clipboard and active_phase.is_figure_phase and not enable_auto_code_block_execution:
                        copy_to_clipboard(sbatch_figs_start_slurm_scripts, message_print=True)
                    if enable_auto_code_block_execution and active_phase.is_figure_phase:
                        print(f'Submitting {active_phase.name} figure scripts...')
                        figs_job_ids = submit_slurm_scripts(figs_slurm_paths)
                        wait_for_slurm_jobs(figs_job_ids, poll_seconds=slurm_poll_seconds)

            write_phase_manifest(phase_name=active_phase.name, run_slurm_paths=run_slurm_paths, figs_slurm_paths=figs_slurm_paths, run_job_ids=run_job_ids, figs_job_ids=figs_job_ids, manifest_output_dir=phase_manifest_dir)

        print(f"Completed phase: {active_phase.name}")

        # Wait between phases if requested (except for the last phase)
        if wait_between_phases and phase_idx < len(phases_to_run) - 1:
            response = input(f"\nPhase {active_phase.name} completed. Press Enter to continue to next phase, or 'q' to quit: ")
            if response.lower() == 'q':
                print("Processing stopped by user.")
                break

    print(f"\n{'='*80}")
    print("ALL PHASES COMPLETED")
    print(f"{'='*80}")


# %%

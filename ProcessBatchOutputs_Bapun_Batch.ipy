#
# CALL EXAMPLES:
#   ipython ProcessBatchOutputs_Bapun_Batch.ipy -- --date 2026-11-27 --computer GL --tbin 0.050 --phases 12
#   ipython ProcessBatchOutputs_Bapun_Batch.ipy -- --date 2026-11-27 --computer GL --tbin 0.050 --phases 123
#   ipython ProcessBatchOutputs_Bapun_Batch.ipy -- --date 2026-11-27 --computer GL --only export_bapun_train_test
#   ipython ProcessBatchOutputs_Bapun_Batch.ipy -- --date 2026-11-27 --computer GL --tbin 0.050 --phases 12 --status
#   ipython ProcessBatchOutputs_Bapun_Batch.ipy -- --date 2026-11-27 --computer Lab --phases 12
#
